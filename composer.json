{
  "name": "pawspa/du-an-web",
  "description": "Pawspa - Pet Care Service Web Application",
  "license": "proprietary",
  "require": {
    "bramus/router": "~1.6",
    "vlucas/phpdotenv": "^5.6",
    "phpmailer/phpmailer": "^6.10"
  },
  "autoload": {
    "psr-4": {
      "App\\": "./src"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6"
  },
  "scripts": {
    "dev": "php -S localhost:8000 -t ./public server.php",
    "test": "vendor/bin/phpunit --testdox",
    "test:coverage": "vendor/bin/phpunit --coverage-clover coverage/clover.xml --coverage-text"
  },
  "config": {
    "process-timeout": 0
  }
}

